{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"extends": ["../../biome.json"],
	"overrides": [
		{
			"include": ["**/env.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": "off"
					}
				}
			}
		},
		{
			"include": ["vitest.config.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noNodejsModules": "off"
					}
				}
			}
		}
	]
}
