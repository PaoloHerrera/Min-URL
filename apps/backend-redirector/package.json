{
	"name": "backend-redirector",
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"lintfix": "biome lint --fix",
		"format": "prettier --write \"src/**/*.{js,ts,css,json}\"",
		"format:check": "prettier --check \"src/**/*.{js,ts,css,json}\"",
		"test": "vitest"
	},
	"dependencies": {
		"@min-url/contracts": "workspace:*",
		"fastify": "5.10.0",
		"fastify-type-provider-zod": "7.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "26.1.1",
		"@types/supertest": "7.2.1",
		"supertest": "7.2.2",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	}
}
