{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"lint": "biome lint .",
		"lintfix": "biome lint --fix",
		"format": "prettier --write \"src/**/*.{astro,js,tsx,jsx,ts,css,json,md}\" --plugin=prettier-plugin-astro",
		"format:check": "prettier --check \"src/**/*.{astro,js,tsx,jsx,ts,css,json}\" --plugin=prettier-plugin-astro",
		"typecheck": "astro check --types",
		"typefix": "astro check --fix",
		"test": "vitest",
		"test:watch": "vitest watch",
		"coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.1",
		"@types/canvas-confetti": "1.9.0",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/validator": "13.15.10",
		"happy-dom": "20.10.6",
		"msw": "2.14.6",
		"prettier": "3.8.4",
		"prettier-plugin-astro": "0.14.1",
		"typescript": "6.0.3",
		"vite": "6.4.3",
		"vitest": "4.1.10"
	},
	"dependencies": {
		"@astrojs/check": "0.9.9",
		"@astrojs/react": "5.0.7",
		"@tailwindcss/vite": "4.3.1",
		"@vitejs/plugin-react-swc": "4.3.1",
		"astro": "7.1.3",
		"axios": "1.18.1",
		"canvas-confetti": "1.9.4",
		"daisyui": "5.6.7",
		"just-debounce-it": "3.2.0",
		"motion": "12.0.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"sharp": "0.35.3",
		"tailwindcss": "4.3.1",
		"validator": "13.15.35",
		"zod": "4.4.3"
	}
}
