---
/**
 * NavLinks
 * Center navigation anchor links. Receives translated strings as props.
 * `base` is an empty string on the home page and the lang root (e.g. '/' or '/es/')
 * on all other pages so anchors resolve correctly from any route.
 */
interface Props {
	home: string
	features: string
	dashboard: string
	why: string
	faq: string
	sponsor: string
	base?: string
}

const { home, features, dashboard, why, faq, sponsor, base = '' } = Astro.props

const isHome = base === ''

const links = [
	{ href: isHome ? '#' : base || '/', label: home },
	{ href: `${base}#features`, label: features },
	{ href: `${base}#dashboard`, label: dashboard },
	{ href: `${base}#why`, label: why },
	{ href: `${base}#faq`, label: faq },
	{ href: `${base}#sponsor`, label: sponsor },
]
---

<nav class="hidden xl:flex items-center gap-1">
	{
		links.map(({ href, label }) => (
			<a
				href={href}
				class="btn btn-ghost btn-md text-sm text-gray-300 hover:text-white font-semibold justify-center px-3.5"
			>
				{label}
			</a>
		))
	}
</nav>
