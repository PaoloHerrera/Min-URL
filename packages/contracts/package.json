{
	"name": "@min-url/contracts",
	"type": "module",
	"exports": {
		"./errors": "./src/errors.ts",
		"./dto": "./src/dto.ts",
		"./schemas": "./src/schemas.ts",
		"./analytics": "./src/analytics.ts"
	},
	"scripts": {
