{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "build/**", ".astro/**"]
		},
		"lint": {
			"outputs": []
		},
		"lintfix": {
			"cache": false,
			"outputs": []
		},
		"test": {
			"env": [
				"PORT",
				"DATABASE_URL",
				"ADMIN_URL",
				"FRONTEND_URL",
				"BACKEND_API_URL",
				"INTERNAL_SECRET",
				"CORS_ALLOWED_ORIGINS",
				"TURNSTILE_SITEKEY",
				"TURNSTILE_SECRET_KEY",
				"NODE_ENV",
				"REDIRECTOR_URL",
				"REDIS_URL",
				"REDIS_PORT"
			],
			"outputs": []
		},
		"typecheck": {
			"outputs": []
		},
		"format": {
			"cache": false,
			"outputs": []
		},
		"format:check": {
			"outputs": []
		},
		"dev": {
			"cache": false
		},
		"start": {}
	}
}
